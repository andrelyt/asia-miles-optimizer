{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route_graph.schema.json",
  "title": "Route Graph Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "observed_at",
    "edges"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin",
          "destination",
          "operating_carrier",
          "distance_miles",
          "cabins",
          "route_status"
        ],
        "properties": {
          "origin": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "operating_carrier": {
            "type": "string",
            "minLength": 2
          },
          "alliance": {
            "type": [
              "string",
              "null"
            ]
          },
          "distance_miles": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "distance_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "cabins": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Y",
                "W",
                "J",
                "F"
              ]
            }
          },
          "route_status": {
            "enum": [
              "VERIFIED",
              "STALE",
              "UNVERIFIED"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      }
    }
  }
}
